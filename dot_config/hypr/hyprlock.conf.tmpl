$font = JetBrains Mono

general {
    hide_cursor = false
    ignore_empty_input = true
}

# Password/PAM authentication only: this machine has no fingerprint reader.
auth {
    pam {
        enabled = true
    }
    fingerprint {
        enabled = false
    }
}

animations {
    enabled = false
}

background {
    monitor =
    path = {{ .chezmoi.sourceDir }}/srcs/wallpapers/wallpaper.png
    blur_passes = 0
}

input-field {
    monitor =
    size = 50, 50
    outline_thickness = 5
    dots_size = 0.2
    hide_input = true
    inner_color = rgba(0, 0, 0, 0.0)
    outer_color = rgb(ffffff)
    check_color = rgba(00ff99ee) rgba(ff6633ee) 120deg
    fail_color = rgb(ff0000)
    font_color = rgb(143, 143, 143)
    fade_on_empty = true
    rounding = -1
    font_family = $font
    placeholder_text =
    fail_text =
    dots_spacing = 0.3
    position = 30, 20
    halign = left
    valign = bottom
}

label {
    monitor =
    text = $FAIL
    font_size = 12
    font_family = $font
    position = 100, 35
    halign = left
    valign = bottom
}

label {
    monitor =
    text = $TIME
    font_size = 60
    font_family = $font
    position = -30, 40
    halign = right
    valign = bottom
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B %Y"
    font_size = 15
    font_family = $font
    position = -30, 20
    halign = right
    valign = bottom
}
