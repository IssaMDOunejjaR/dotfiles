#!/bin/bash
set -euo pipefail

# Use the Lua API so pinning/floating/tagging target the same window atomically.
hyprctl eval '
local window = hl.get_active_window()
if window == nil then return end
if window.pinned then
    hl.dispatch(hl.dsp.window.pin({ window = window, action = "unset" }))
    hl.dispatch(hl.dsp.window.float({ window = window, action = "unset" }))
    hl.dispatch(hl.dsp.window.tag({ window = window, tag = "-pop" }))
else
    hl.dispatch(hl.dsp.window.float({ window = window, action = "set" }))
    hl.dispatch(hl.dsp.window.center({ window = window }))
    hl.dispatch(hl.dsp.window.pin({ window = window, action = "set" }))
    hl.dispatch(hl.dsp.window.alter_zorder({ window = window, mode = "top" }))
    hl.dispatch(hl.dsp.window.tag({ window = window, tag = "+pop" }))
end
'
