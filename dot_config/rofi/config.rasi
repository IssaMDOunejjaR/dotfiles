configuration {
  modes: "drun,run,filebrowser";
  show-icons: true;
  terminal: "velocitty";
  font: "JetBrainsMono Nerd Font 12";
  kb-row-up: "Control+p";
  kb-row-down: "Control+n";

  filebrowser {
    directory: "~";
    show-hidden: true;
    command: "velocitty -e nvim";
  }
}

@theme "style"
