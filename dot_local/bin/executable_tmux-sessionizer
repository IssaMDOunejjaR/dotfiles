#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$({
    zoxide query -l
    fd . ~/Documents/projects/ ~/Documents/learning/ ~/.config/ ~/ -d 1 -t d
  } | sort -u | fzf)
fi

if [[ -z $selected ]]; then
  exit 0
fi

# Tell zoxide we visited this directory
zoxide add "$selected"

# Replace dots and colons with underscores for tmux session naming
selected_name=$(basename "$selected" | tr . _:)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s "$selected_name" -c "$selected"
  exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "$selected_name"
